<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - Flower Life' : 'Flower Life — 花卉生活美學' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --cream:        #F7F0E6;
      --cream-light:  #FDF9F4;
      --cream-mid:    #EDE3D5;
      --maroon:       #6B1E2A;
      --maroon-dark:  #4A1219;
      --maroon-light: #9B3A4A;
      --maroon-mist:  #F9F0F1;
      --gold:         #B8965A;
      --gold-light:   #D4B07A;
      --charcoal:     #2A1A1F;
      --text-muted-c: #7A6068;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: 'Jost', sans-serif;
      background-color: var(--cream-light);
      color: var(--charcoal);
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    h1, h2, h3, h4, h5, .font-serif {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 400;
      letter-spacing: .01em;
    }

    main { flex: 1; }

    /* ── Notification Toast ── */
    .fl-toast {
      position: fixed;
      top: 5rem;
      right: 1rem;
      z-index: 9999;
      padding: .7rem 1.2rem;
      border-radius: 3px;
      font-size: .85rem;
      font-family: 'Jost', sans-serif;
      box-shadow: 0 4px 20px rgba(0,0,0,.15);
      transition: opacity .3s;
      min-width: 200px;
    }
    .fl-toast-success { background: #3D7A5C; color: #fff; }
    .fl-toast-error   { background: var(--maroon); color: #fff; }
    .fl-toast-warning { background: var(--gold); color: #fff; }
    .fl-toast-info    { background: var(--charcoal); color: #fff; }

    /* ── Spinner ── */
    .fl-spinner {
      width: 2rem; height: 2rem;
      border: 3px solid var(--cream-mid);
      border-top-color: var(--maroon);
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Buttons ── */
    .btn-maroon {
      background: var(--maroon); color: #fff;
      border: none; border-radius: 2px;
      font-family: 'Jost', sans-serif;
      font-size: .8rem; font-weight: 600;
      letter-spacing: .12em; text-transform: uppercase;
      padding: .75rem 1.6rem;
      transition: background .2s, transform .15s;
      text-decoration: none;
      display: inline-block;
      cursor: pointer;
    }
    .btn-maroon:hover, .btn-maroon:focus {
      background: var(--maroon-dark); color: #fff;
      transform: translateY(-1px);
    }
    .btn-maroon:disabled {
      opacity: .55; cursor: not-allowed; transform: none;
    }

    .btn-outline-maroon {
      background: transparent; color: var(--maroon);
      border: 1.5px solid var(--maroon); border-radius: 2px;
      font-family: 'Jost', sans-serif;
      font-size: .8rem; font-weight: 600;
      letter-spacing: .12em; text-transform: uppercase;
      padding: .72rem 1.6rem;
      transition: background .2s, color .2s, transform .15s;
      text-decoration: none; display: inline-block; cursor: pointer;
    }
    .btn-outline-maroon:hover {
      background: var(--maroon); color: #fff;
      transform: translateY(-1px);
    }

    /* ── Form controls override ── */
    .form-control, .form-select {
      border: 1.5px solid var(--cream-mid);
      border-radius: 3px;
      font-family: 'Jost', sans-serif;
      font-size: .9rem;
      color: var(--charcoal);
      background: #fff;
      padding: .7rem 1rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--maroon);
      box-shadow: 0 0 0 3px rgba(107,30,42,.08);
      background: #fff;
      color: var(--charcoal);
    }
    .form-control::placeholder { color: var(--text-muted-c); font-weight: 300; }
    .form-label {
      font-size: .73rem; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--charcoal); margin-bottom: .45rem;
    }
    .form-check-input:checked {
      background-color: var(--maroon); border-color: var(--maroon);
    }
    .form-check-input:focus { box-shadow: 0 0 0 3px rgba(107,30,42,.1); }

    /* ── Card base ── */
    .fl-card {
      background: #fff;
      border: 1px solid var(--cream-mid);
      border-radius: 3px;
    }

    /* ── Status badges ── */
    .status-pending { background: #FEF3C7; color: #92400E; }
    .status-paid    { background: #D1FAE5; color: #065F46; }
    .status-failed  { background: #FEE2E2; color: #991B1B; }

    /* ── Section headers ── */
    .section-eyebrow {
      font-size: .72rem; font-weight: 600;
      letter-spacing: .2em; text-transform: uppercase;
      color: var(--gold); margin-bottom: .5rem;
    }
    .section-divider {
      width: 40px; height: 2px;
      background: var(--maroon); margin: .8rem 0 0;
    }

    /* ── Animations ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp .65s ease both; }
    .delay-1 { animation-delay: .15s; }
    .delay-2 { animation-delay: .3s; }
    .delay-3 { animation-delay: .45s; }
  </style>
</head>
