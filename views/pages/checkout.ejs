<div id="app" class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <h1 class="mb-4" style="font-size:clamp(1.8rem,3.5vw,2.4rem);font-weight:500;">
        <i class="bi bi-credit-card me-2" style="color:var(--maroon);"></i>結帳
      </h1>

      <div v-if="loading" class="d-flex justify-content-center py-5">
        <div class="fl-spinner"></div>
      </div>

      <div v-else class="row g-4">
        <!-- Left: Form -->
        <div class="col-lg-7">
          <div class="fl-card p-4">
            <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;margin-bottom:1.2rem;">收件資訊</h5>
            <div class="mb-3">
              <label class="form-label" style="font-size:.82rem;color:var(--text-muted-c);">收件人姓名</label>
              <input
                v-model="form.recipientName"
                type="text"
                placeholder="請輸入收件人姓名"
                class="form-control"
                :class="{ 'is-invalid': errors.recipientName }"
                style="font-size:.88rem;border-color:var(--cream-mid);border-radius:2px;"
              />
              <div v-if="errors.recipientName" class="invalid-feedback" style="font-size:.78rem;">{{ errors.recipientName }}</div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-size:.82rem;color:var(--text-muted-c);">Email</label>
              <input
                v-model="form.recipientEmail"
                type="email"
                placeholder="請輸入 Email"
                class="form-control"
                :class="{ 'is-invalid': errors.recipientEmail }"
                style="font-size:.88rem;border-color:var(--cream-mid);border-radius:2px;"
              />
              <div v-if="errors.recipientEmail" class="invalid-feedback" style="font-size:.78rem;">{{ errors.recipientEmail }}</div>
            </div>
            <div class="mb-2">
              <label class="form-label" style="font-size:.82rem;color:var(--text-muted-c);">收件地址</label>
              <input
                v-model="form.recipientAddress"
                type="text"
                placeholder="請輸入收件地址"
                class="form-control"
                :class="{ 'is-invalid': errors.recipientAddress }"
                style="font-size:.88rem;border-color:var(--cream-mid);border-radius:2px;"
              />
              <div v-if="errors.recipientAddress" class="invalid-feedback" style="font-size:.78rem;">{{ errors.recipientAddress }}</div>
            </div>
          </div>
        </div>

        <!-- Right: Summary -->
        <div class="col-lg-5">
          <div class="fl-card p-4" style="position:sticky;top:6rem;">
            <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;margin-bottom:1.2rem;">訂單摘要</h5>

            <div v-for="item in cartItems" :key="item.id"
              class="d-flex justify-content-between mb-2"
              style="font-size:.85rem;"
            >
              <span style="color:var(--text-muted-c);">{{ item.product.name }} x {{ item.quantity }}</span>
              <span style="color:var(--charcoal);">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
            </div>

            <hr style="border-color:var(--cream-mid);margin:1rem 0;">

            <div class="d-flex justify-content-between mb-2" style="font-size:.88rem;">
              <span style="color:var(--text-muted-c);">商品小計</span>
              <span style="color:var(--charcoal);">NT$ {{ cartTotal.toLocaleString() }}</span>
            </div>
            <div class="d-flex justify-content-between mb-3" style="font-size:.88rem;">
              <span style="color:var(--text-muted-c);">運費</span>
              <span style="color:var(--charcoal);">{{ cartTotal >= 800 ? '免運' : 'NT$ 150' }}</span>
            </div>

            <hr style="border-color:var(--cream-mid);">
            <div class="d-flex justify-content-between mb-4">
              <span style="font-weight:700;color:var(--charcoal);">總計</span>
              <span style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:500;color:var(--maroon);">
                NT$ {{ (cartTotal + (cartTotal >= 800 ? 0 : 150)).toLocaleString() }}
              </span>
            </div>

            <button
              @click="submitOrder"
              :disabled="submitting"
              class="btn-maroon w-100"
              style="padding:1rem;font-size:.82rem;"
            >
              {{ submitting ? '處理中...' : '確認送出訂單' }}
            </button>
            <a href="/cart" class="d-block text-center mt-3" style="font-size:.78rem;color:var(--text-muted-c);text-decoration:none;">
              ← 返回購物車
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
