<style>
  /* Override body for login page - no flex column needed */
  body { display: block !important; }

  .fl-auth-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }
  @media (max-width: 767.98px) {
    .fl-auth-wrap { grid-template-columns: 1fr; }
    .fl-auth-visual { min-height: 260px; order: 0; }
    .fl-auth-panel { order: 1; }
  }

  .fl-auth-visual {
    position: relative; overflow: hidden;
  }
  .fl-auth-visual img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .fl-auth-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, rgba(74,18,25,.7) 0%, rgba(107,30,42,.45) 100%);
  }
  .fl-auth-visual-content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem; color: #fff;
  }
  .fl-auth-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem; font-weight: 500;
    letter-spacing: .1em; text-decoration: none; color: #fff;
  }
  .fl-auth-logo span { color: var(--gold-light); font-weight: 300; }

  .fl-auth-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    font-weight: 300; line-height: 1.25;
    color: #fff; font-style: italic;
  }
  .fl-auth-quote-attr {
    font-size: .72rem; color: rgba(255,255,255,.5);
    letter-spacing: .1em; margin-top: .7rem;
  }

  .fl-perk {
    display: flex; align-items: flex-start; gap: .8rem;
  }
  .fl-perk-icon {
    width: 34px; height: 34px; flex-shrink: 0;
    background: rgba(184,150,90,.2);
    border: 1px solid rgba(184,150,90,.3);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--gold-light); font-size: .85rem;
  }

  .fl-auth-panel {
    display: flex; flex-direction: column;
    justify-content: center;
    padding: 3rem 2rem;
    background: var(--cream-light);
    overflow-y: auto;
  }
  @media (min-width: 768px) { .fl-auth-panel { padding: 3rem 4rem; } }
  .fl-form-inner { max-width: 420px; margin: 0 auto; width: 100%; }

  /* Tabs */
  .fl-tabs {
    display: flex; border-bottom: 1.5px solid var(--cream-mid);
    margin-bottom: 2rem;
  }
  .fl-tab {
    background: none; border: none;
    font-family: 'Jost', sans-serif;
    font-size: .76rem; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--text-muted-c);
    padding: .85rem 1.5rem .7rem;
    cursor: pointer; position: relative;
    transition: color .2s;
  }
  .fl-tab::after {
    content: ''; position: absolute;
    bottom: -1.5px; left: 0; right: 0;
    height: 2.5px; background: var(--maroon);
    transform: scaleX(0); transition: transform .25s ease;
  }
  .fl-tab.active { color: var(--maroon); }
  .fl-tab.active::after { transform: scaleX(1); }

  /* Social buttons */
  .fl-social-btn {
    display: flex; align-items: center; justify-content: center;
    gap: .6rem; background: #fff;
    border: 1.5px solid var(--cream-mid); border-radius: 3px;
    font-family: 'Jost', sans-serif;
    font-size: .82rem; font-weight: 500;
    color: var(--charcoal); padding: .7rem 1rem;
    width: 100%; cursor: pointer;
    transition: border-color .2s, background .2s;
    text-decoration: none;
  }
  .fl-social-btn:hover {
    border-color: var(--maroon-light);
    background: var(--maroon-mist); color: var(--charcoal);
  }

  .fl-divider {
    display: flex; align-items: center; gap: .9rem;
    margin: 1.2rem 0; color: var(--text-muted-c);
    font-size: .76rem; letter-spacing: .06em;
  }
  .fl-divider::before, .fl-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--cream-mid);
  }

  /* Password toggle */
  .fl-input-group .form-control {
    border-right: none; border-radius: 3px 0 0 3px;
  }
  .fl-input-toggle {
    background: #fff; border: 1.5px solid var(--cream-mid);
    border-left: none; border-radius: 0 3px 3px 0;
    cursor: pointer; color: var(--text-muted-c);
    padding: .7rem .9rem; transition: color .2s;
  }
  .fl-input-toggle:hover { color: var(--maroon); }
  .fl-input-group .form-control:focus ~ .fl-input-toggle {
    border-color: var(--maroon);
  }

  .fl-auth-switch {
    text-align: center; font-size: .82rem;
    color: var(--text-muted-c); margin-top: 1.3rem;
  }
  .fl-auth-switch a { color: var(--maroon); font-weight: 600; text-decoration: none; }
  .fl-auth-switch a:hover { text-decoration: underline; }

  .fl-error-box {
    background: var(--maroon-mist);
    border: 1px solid rgba(107,30,42,.18);
    border-radius: 3px; color: var(--maroon);
    font-size: .82rem; padding: .6rem .9rem;
    margin-top: .8rem;
  }
</style>

<div id="app">
  <div class="fl-auth-wrap">

    <!-- Left: Visual -->
    <div class="fl-auth-visual">
      <img src="https://images.unsplash.com/photo-1465146344425-f00d5f5c8f07?w=800&q=80" alt="花卉" />
      <div class="fl-auth-overlay"></div>
      <div class="fl-auth-visual-content">
        <a class="fl-auth-logo" href="/">Flower <span>Life</span></a>

        <div>
          <div class="fl-auth-quote">
            "花朵是大地的<br>最美詩篇，每一瓣<br>都述說著愛。"
          </div>
          <div class="fl-auth-quote-attr">— FLOWER LIFE 品牌精神</div>

          <div class="d-flex flex-column gap-3 mt-4">
            <div class="fl-perk">
              <div class="fl-perk-icon"><i class="bi bi-truck"></i></div>
              <div>
                <div style="font-size:.76rem;font-weight:600;color:rgba(255,255,255,.9);letter-spacing:.04em;">全台免費配送</div>
                <div style="font-size:.68rem;color:rgba(255,255,255,.5);">訂單滿 NT$800 即享</div>
              </div>
            </div>
            <div class="fl-perk">
              <div class="fl-perk-icon"><i class="bi bi-flower1"></i></div>
              <div>
                <div style="font-size:.76rem;font-weight:600;color:rgba(255,255,255,.9);letter-spacing:.04em;">當季最新鮮花卉</div>
                <div style="font-size:.68rem;color:rgba(255,255,255,.5);">直接向花農採購</div>
              </div>
            </div>
            <div class="fl-perk">
              <div class="fl-perk-icon"><i class="bi bi-award"></i></div>
              <div>
                <div style="font-size:.76rem;font-weight:600;color:rgba(255,255,255,.9);letter-spacing:.04em;">會員專屬優惠</div>
                <div style="font-size:.68rem;color:rgba(255,255,255,.5);">首購 9 折，積點兌換禮品</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Form -->
    <div class="fl-auth-panel">
      <div class="fl-form-inner">

        <!-- Tabs -->
        <div class="fl-tabs">
          <button class="fl-tab" :class="{ active: activeTab === 'login' }" @click="activeTab = 'login'; errors = {}">登入</button>
          <button class="fl-tab" :class="{ active: activeTab === 'register' }" @click="activeTab = 'register'; errors = {}">建立帳號</button>
        </div>

        <!-- Welcome text -->
        <div class="mb-3 fade-up">
          <h1 style="font-size:2rem;font-weight:500;color:var(--charcoal);margin-bottom:.25rem;">
            {{ activeTab === 'login' ? '歡迎回來' : '加入我們' }}
          </h1>
          <p style="font-size:.85rem;color:var(--text-muted-c);">
            {{ activeTab === 'login' ? '登入以查看訂單、購物車與會員專屬優惠。' : '免費建立帳號，探索花卉世界的美好。' }}
          </p>
        </div>

        <!-- Social buttons -->
        <div class="d-flex flex-column gap-2 mb-2">
          <a href="#" class="fl-social-btn">
            <svg width="17" height="17" viewBox="0 0 48 48">
              <path fill="#EA4335" d="M24 9.5c3.5 0 6.3 1.2 8.5 3.2l6.4-6.4C34.8 2.7 29.8.5 24 .5 14.9.5 7.1 5.8 3.4 13.4l7.5 5.8C12.7 13.3 17.9 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.4 5.7c4.3-4 6.8-9.8 6.8-16.9z"/>
              <path fill="#FBBC05" d="M10.9 28.8A14.8 14.8 0 0 1 9.5 24c0-1.7.3-3.3.8-4.8l-7.5-5.8A23.5 23.5 0 0 0 .5 24c0 3.8.9 7.4 2.5 10.6l7.9-5.8z"/>
              <path fill="#34A853" d="M24 47.5c5.8 0 10.7-1.9 14.3-5.2l-7.4-5.7c-2 1.3-4.5 2.1-6.9 2.1-6.1 0-11.3-3.8-13.2-9.1l-7.9 5.8C7.1 42.2 14.9 47.5 24 47.5z"/>
            </svg>
            以 Google 帳號繼續
          </a>
          <a href="#" class="fl-social-btn">
            <i class="bi bi-line" style="font-size:1.05rem;color:#06C755;"></i>
            以 LINE 帳號繼續
          </a>
        </div>

        <div class="fl-divider">或使用電子郵件</div>

        <!-- Login Form -->
        <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" novalidate>
          <div class="mb-3">
            <label class="form-label" for="loginEmail">電子郵件</label>
            <input
              id="loginEmail"
              v-model="loginForm.email"
              type="email"
              class="form-control"
              :class="{ 'is-invalid': errors.email }"
              placeholder="your@email.com"
            />
            <div class="invalid-feedback" v-if="errors.email">{{ errors.email }}</div>
          </div>

          <div class="mb-2">
            <label class="form-label" for="loginPwd">密碼</label>
            <div class="input-group fl-input-group">
              <input
                id="loginPwd"
                v-model="loginForm.password"
                :type="showPwd ? 'text' : 'password'"
                class="form-control"
                :class="{ 'is-invalid': errors.password }"
                placeholder="輸入密碼"
              />
              <button type="button" class="fl-input-toggle" @click="showPwd = !showPwd">
                <i :class="showPwd ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
              </button>
            </div>
            <div v-if="errors.password" style="font-size:.75rem;color:var(--maroon);margin-top:.25rem;">{{ errors.password }}</div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="rememberMe" />
              <label class="form-check-label" for="rememberMe" style="font-size:.8rem;color:var(--text-muted-c);">記住我</label>
            </div>
            <a href="#" style="font-size:.78rem;color:var(--maroon);text-decoration:none;font-weight:500;">忘記密碼？</a>
          </div>

          <button type="submit" class="btn-maroon w-100" :disabled="submitting" style="padding:1rem;font-size:.82rem;">
            {{ submitting ? '登入中…' : '登入帳號' }}
          </button>

          <div v-if="errors.general" class="fl-error-box">{{ errors.general }}</div>
        </form>

        <!-- Register Form -->
        <form v-else @submit.prevent="handleRegister" novalidate>
          <div class="mb-3">
            <label class="form-label" for="regName">姓名 / 暱稱</label>
            <input
              id="regName"
              v-model="registerForm.name"
              type="text"
              class="form-control"
              :class="{ 'is-invalid': errors.name }"
              placeholder="請輸入姓名"
            />
            <div class="invalid-feedback" v-if="errors.name">{{ errors.name }}</div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="regEmail">電子郵件</label>
            <input
              id="regEmail"
              v-model="registerForm.email"
              type="email"
              class="form-control"
              :class="{ 'is-invalid': errors.email }"
              placeholder="your@email.com"
            />
            <div class="invalid-feedback" v-if="errors.email">{{ errors.email }}</div>
          </div>

          <div class="mb-4">
            <label class="form-label" for="regPwd">密碼</label>
            <div class="input-group fl-input-group">
              <input
                id="regPwd"
                v-model="registerForm.password"
                :type="showPwd ? 'text' : 'password'"
                class="form-control"
                :class="{ 'is-invalid': errors.password }"
                placeholder="至少 6 碼"
              />
              <button type="button" class="fl-input-toggle" @click="showPwd = !showPwd">
                <i :class="showPwd ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
              </button>
            </div>
            <div v-if="errors.password" style="font-size:.75rem;color:var(--maroon);margin-top:.25rem;">{{ errors.password }}</div>
          </div>

          <button type="submit" class="btn-maroon w-100" :disabled="submitting" style="padding:1rem;font-size:.82rem;">
            {{ submitting ? '建立中…' : '建立帳號' }}
          </button>

          <div v-if="errors.general" class="fl-error-box">{{ errors.general }}</div>
        </form>

        <div class="fl-auth-switch">
          <template v-if="activeTab === 'login'">
            還沒有帳號？ <a href="#" @click.prevent="activeTab = 'register'; errors = {}">立即免費加入</a>
          </template>
          <template v-else>
            已有帳號？ <a href="#" @click.prevent="activeTab = 'login'; errors = {}">立即登入</a>
          </template>
        </div>

        <div class="text-center mt-2">
          <a href="/" style="font-size:.76rem;color:var(--text-muted-c);text-decoration:none;">
            <i class="bi bi-arrow-left me-1"></i> 返回首頁
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
