<style>
  .fl-detail-img {
    border-radius: 3px; overflow: hidden;
    aspect-ratio: 4/5;
  }
  .fl-detail-img img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .fl-option-btn {
    background: #fff;
    border: 1.5px solid var(--cream-mid);
    border-radius: 2px; padding: .38rem .9rem;
    font-family: 'Jost', sans-serif;
    font-size: .82rem; color: var(--charcoal);
    cursor: pointer; transition: border-color .2s, background .2s;
  }
  .fl-option-btn:hover { border-color: var(--maroon-light); }
  .fl-option-btn.active {
    border-color: var(--maroon);
    background: var(--maroon-mist); color: var(--maroon);
  }

  .fl-qty-ctrl {
    display: flex; align-items: center;
    border: 1.5px solid var(--cream-mid); border-radius: 3px;
    overflow: hidden; width: fit-content;
  }
  .fl-qty-btn {
    background: none; border: none;
    width: 40px; height: 42px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; cursor: pointer; color: var(--charcoal);
    transition: background .2s;
  }
  .fl-qty-btn:hover { background: var(--cream-mid); }
  .fl-qty-val {
    width: 42px; text-align: center;
    font-size: .95rem; font-weight: 600;
    border: none; border-left: 1.5px solid var(--cream-mid);
    border-right: 1.5px solid var(--cream-mid);
    background: #fff; color: var(--charcoal);
    padding: 0; line-height: 42px;
  }

  .fl-feature-item {
    display: flex; align-items: flex-start; gap: .6rem;
  }
  .fl-feature-icon {
    width: 30px; height: 30px; flex-shrink: 0;
    background: var(--maroon-mist); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--maroon); font-size: .8rem;
  }
  .fl-feature-title { font-size: .8rem; font-weight: 600; color: var(--charcoal); }
  .fl-feature-desc { font-size: .72rem; color: var(--text-muted-c); margin-top: .1rem; }

  /* Detail tabs */
  .fl-detail-tabs {
    border-bottom: 1.5px solid var(--cream-mid);
    display: flex; gap: 0;
  }
  .fl-detail-tab {
    background: none; border: none;
    font-family: 'Jost', sans-serif;
    font-size: .78rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--text-muted-c);
    padding: .82rem 1.4rem .68rem;
    cursor: pointer; position: relative;
    transition: color .2s;
  }
  .fl-detail-tab::after {
    content: ''; position: absolute;
    bottom: -1.5px; left: 0; right: 0;
    height: 2.5px; background: var(--maroon);
    transform: scaleX(0); transition: transform .25s ease;
  }
  .fl-detail-tab.active { color: var(--maroon); }
  .fl-detail-tab.active::after { transform: scaleX(1); }
</style>

<div id="app" data-product-id="<%= productId %>">
  <div class="container py-4">

    <!-- Loading -->
    <div v-if="loading" class="d-flex justify-content-center py-5">
      <div class="fl-spinner"></div>
    </div>

    <!-- Not Found -->
    <div v-else-if="notFound" class="text-center py-5">
      <div style="font-size:3rem;margin-bottom:.8rem;">🌸</div>
      <h2 style="font-size:1.4rem;color:var(--charcoal);margin-bottom:.5rem;">找不到此商品</h2>
      <a href="/" class="btn-outline-maroon" style="font-size:.78rem;">回到首頁</a>
    </div>

    <!-- Product Detail -->
    <template v-else-if="product">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-size:.78rem;">
          <li class="breadcrumb-item"><a href="/" style="color:var(--text-muted-c);text-decoration:none;">首頁</a></li>
          <li class="breadcrumb-item active" style="color:var(--charcoal);">{{ product.name }}</li>
        </ol>
      </nav>

      <div class="row g-5">
        <!-- Image -->
        <div class="col-lg-6">
          <div class="fl-detail-img">
            <img
              :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=700'"
              :alt="product.name"
            />
          </div>
        </div>

        <!-- Info -->
        <div class="col-lg-6">
          <div class="section-eyebrow">精選花卉</div>
          <h1 style="font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:500;color:var(--charcoal);margin-bottom:.6rem;">
            {{ product.name }}
          </h1>

          <!-- Stock -->
          <div class="mb-3" style="font-size:.82rem;">
            <span v-if="product.stock > 0" style="color:#3D7A5C;">
              <i class="bi bi-check-circle me-1"></i>尚有 {{ product.stock }} 件
            </span>
            <span v-else style="color:var(--maroon);">
              <i class="bi bi-x-circle me-1"></i>已售完
            </span>
          </div>

          <!-- Price -->
          <div style="font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:500;color:var(--maroon);margin-bottom:1rem;">
            NT$ {{ product.price.toLocaleString() }}
          </div>
          <p style="font-size:.85rem;color:var(--text-muted-c);margin-bottom:1.5rem;">
            含運費（訂單滿 NT$800 免運）
          </p>

          <p v-if="product.description" style="font-size:.92rem;line-height:1.8;color:var(--text-muted-c);margin-bottom:1.8rem;">
            {{ product.description }}
          </p>

          <hr style="border-color:var(--cream-mid);margin:1.5rem 0;">

          <!-- Quantity -->
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="form-label mb-0">數量</div>
            <div class="fl-qty-ctrl">
              <button class="fl-qty-btn" @click="decrease">−</button>
              <span class="fl-qty-val">{{ quantity }}</span>
              <button class="fl-qty-btn" @click="increase">+</button>
            </div>
          </div>

          <!-- CTA -->
          <div class="d-flex gap-2 mb-4">
            <button
              class="btn-maroon flex-grow-1"
              style="padding:1rem;"
              @click="addToCart"
              :disabled="adding || product.stock <= 0"
            >
              <i class="bi bi-bag-plus me-1"></i>
              {{ product.stock <= 0 ? '已售完' : (adding ? '加入中…' : '加入購物車') }}
            </button>
            <a href="/cart" class="btn-outline-maroon" style="padding:1rem 1.2rem;white-space:nowrap;">
              <i class="bi bi-bag"></i>
            </a>
          </div>

          <!-- Features grid -->
          <div class="row g-3 mb-4">
            <div class="col-6">
              <div class="fl-feature-item">
                <div class="fl-feature-icon"><i class="bi bi-truck"></i></div>
                <div>
                  <div class="fl-feature-title">全台免費配送</div>
                  <div class="fl-feature-desc">訂單滿 NT$800</div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="fl-feature-item">
                <div class="fl-feature-icon"><i class="bi bi-clock"></i></div>
                <div>
                  <div class="fl-feature-title">24 小時新鮮</div>
                  <div class="fl-feature-desc">當天採摘送達</div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="fl-feature-item">
                <div class="fl-feature-icon"><i class="bi bi-award"></i></div>
                <div>
                  <div class="fl-feature-title">品質保證</div>
                  <div class="fl-feature-desc">不滿意全額退款</div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="fl-feature-item">
                <div class="fl-feature-icon"><i class="bi bi-gift"></i></div>
                <div>
                  <div class="fl-feature-title">精美包裝</div>
                  <div class="fl-feature-desc">附贈手寫心意卡</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Notes -->
          <div style="background:var(--cream);border-radius:3px;padding:1.2rem 1.4rem;">
            <div style="font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--charcoal);margin-bottom:.6rem;">購買須知</div>
            <ul style="margin:0;padding-left:1.2rem;font-size:.8rem;color:var(--text-muted-c);line-height:1.9;">
              <li>花材依據季節供應，實際花束可能略有差異</li>
              <li>台北市區可享當日配送服務</li>
              <li>消費滿 NT$ 800 享免運優惠</li>
            </ul>
          </div>
        </div>
      </div><!-- /row -->

      <!-- Detail Tabs -->
      <div class="mt-5 pt-3">
        <div class="fl-detail-tabs" id="detailTabs">
          <button class="fl-detail-tab active" onclick="switchTab('info', this)">商品詳情</button>
          <button class="fl-detail-tab" onclick="switchTab('care', this)">花卉養護</button>
        </div>

        <div id="tab-info" style="padding:2rem 0;display:block;">
          <div style="background:var(--cream);border-radius:3px;padding:1.5rem;font-size:.88rem;color:var(--text-muted-c);line-height:1.9;">
            <ul style="margin:0;padding-left:1.2rem;">
              <li>花朵顏色可能因拍攝光線略有差異</li>
              <li>花束尺寸為估算值，可能有 ±10% 誤差</li>
              <li>收到花束請立即插入水中</li>
              <li>避免直接日曬及冷氣出風口</li>
              <li>每日換水可延長花期至 5-7 天</li>
            </ul>
          </div>
        </div>

        <div id="tab-care" style="padding:2rem 0;display:none;">
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex flex-column gap-3">
                <div class="fl-feature-item">
                  <div class="fl-feature-icon" style="width:36px;height:36px;"><i class="bi bi-droplet-fill"></i></div>
                  <div>
                    <div class="fl-feature-title">每日換水</div>
                    <div class="fl-feature-desc">使用室溫清水，並修剪莖部約 1-2 公分。</div>
                  </div>
                </div>
                <div class="fl-feature-item">
                  <div class="fl-feature-icon" style="width:36px;height:36px;"><i class="bi bi-thermometer-sun"></i></div>
                  <div>
                    <div class="fl-feature-title">適溫保存</div>
                    <div class="fl-feature-desc">置於 15-22°C 室溫，避免直曬及冷氣直吹。</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </template>
  </div>
</div>

<script>
  function switchTab(tabId, btn) {
    document.querySelectorAll('.fl-detail-tab').forEach(t => t.classList.remove('active'));
    ['tab-info', 'tab-care'].forEach(id => {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    btn.classList.add('active');
    var target = document.getElementById('tab-' + tabId);
    if (target) target.style.display = 'block';
  }
</script>
