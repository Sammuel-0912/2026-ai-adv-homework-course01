<div id="app" class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <h1 class="mb-4" style="font-size:clamp(1.8rem,3.5vw,2.4rem);font-weight:500;">
        <i class="bi bi-bag-check me-2" style="color:var(--maroon);"></i>我的訂單
      </h1>

      <div v-if="loading" class="d-flex justify-content-center py-5">
        <div class="fl-spinner"></div>
      </div>

      <div v-else-if="orders.length === 0" class="text-center py-5">
        <i class="bi bi-inbox" style="font-size:3.5rem;color:var(--cream-mid);display:block;margin-bottom:1rem;"></i>
        <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;color:var(--charcoal);margin-bottom:.4rem;">尚無訂單</h5>
        <p style="font-size:.85rem;color:var(--text-muted-c);margin-bottom:1.5rem;">快去選購喜歡的花束吧！</p>
        <a href="/" class="btn-maroon" style="font-size:.78rem;">去逛逛</a>
      </div>

      <div v-else class="d-flex flex-column gap-3">
        <a
          v-for="order in orders"
          :key="order.id"
          :href="'/orders/' + order.id"
          class="fl-card p-4 d-block text-decoration-none"
          style="transition:box-shadow .2s;"
          onmouseover="this.style.boxShadow='0 4px 20px rgba(107,30,42,.1)'"
          onmouseout="this.style.boxShadow=''"
        >
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <div style="font-size:.82rem;color:var(--text-muted-c);">訂單編號：{{ order.order_no }}</div>
              <div style="font-size:.75rem;color:var(--text-muted-c);margin-top:.2rem;">
                {{ new Date(order.created_at).toLocaleDateString('zh-TW') }}
              </div>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span style="font-weight:700;color:var(--charcoal);font-size:.95rem;">
                NT$ {{ order.total_amount.toLocaleString() }}
              </span>
              <span
                style="font-size:.72rem;padding:.3rem .8rem;border-radius:2px;font-weight:600;letter-spacing:.04em;"
                :style="statusMap[order.status]?.style || 'background:#f3f4f6;color:#6b7280;'"
              >
                {{ statusMap[order.status]?.label || order.status }}
              </span>
              <i class="bi bi-chevron-right" style="color:var(--text-muted-c);font-size:.8rem;"></i>
            </div>
          </div>
        </a>
      </div>

    </div>
  </div>
</div>
