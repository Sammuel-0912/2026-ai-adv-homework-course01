<style>
  /* ── Banner Strip ── */
  .fl-banner {
    background: var(--maroon);
    color: rgba(255,255,255,.85);
    font-size: .72rem; font-weight: 500;
    letter-spacing: .16em; text-transform: uppercase;
    text-align: center; padding: .6rem 1rem;
  }

  /* ── Hero ── */
  .fl-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 88vh;
    overflow: hidden;
  }
  @media (max-width: 767.98px) {
    .fl-hero { grid-template-columns: 1fr; min-height: auto; }
    .fl-hero-img { order: 0; min-height: 55vw; }
    .fl-hero-content { order: 1; }
  }

  .fl-hero-content {
    display: flex; flex-direction: column;
    justify-content: center;
    padding: 5rem 4rem 5rem 5vw;
    background: var(--cream-light);
  }
  @media (max-width: 991.98px) { .fl-hero-content { padding: 3rem 2rem; } }

  .fl-hero-eyebrow {
    font-size: .72rem; font-weight: 600;
    letter-spacing: .22em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1rem;
    display: flex; align-items: center; gap: .6rem;
  }
  .fl-hero-eyebrow::before {
    content: ''; display: inline-block;
    width: 28px; height: 1px; background: var(--gold);
  }

  .fl-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    line-height: 1.06; color: var(--charcoal);
    margin-bottom: 1.5rem;
  }
  .fl-hero-title em { font-style: italic; color: var(--maroon); }

  .fl-hero-desc {
    font-size: .95rem; line-height: 1.75;
    color: var(--text-muted-c); max-width: 380px;
    margin-bottom: 2.2rem;
  }

  .fl-hero-img {
    position: relative; overflow: hidden;
  }
  .fl-hero-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 8s ease;
  }
  .fl-hero-img:hover img { transform: scale(1.04); }
  .fl-hero-img::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(107,30,42,.15) 0%, transparent 60%);
  }

  .fl-hero-badge {
    position: absolute; bottom: 1.5rem; left: 1.5rem;
    background: var(--cream-light);
    border: 1px solid var(--cream-mid);
    border-radius: 2px; padding: .9rem 1.2rem; z-index: 2;
  }
  .fl-hero-badge .num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem; font-weight: 500;
    color: var(--maroon); line-height: 1;
  }
  .fl-hero-badge .lbl { font-size: .7rem; color: var(--text-muted-c); letter-spacing: .06em; }

  /* ── Product Cards ── */
  .fl-product-card {
    background: #fff;
    border: 1px solid var(--cream-mid);
    border-radius: 3px; overflow: hidden;
    transition: box-shadow .3s, transform .3s;
    cursor: pointer; height: 100%;
  }
  .fl-product-card:hover {
    box-shadow: 0 10px 36px rgba(107,30,42,.12);
    transform: translateY(-4px);
  }
  .fl-product-img {
    position: relative; overflow: hidden;
    aspect-ratio: 1;
  }
  .fl-product-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .55s ease;
  }
  .fl-product-card:hover .fl-product-img img { transform: scale(1.07); }

  .fl-product-body { padding: .9rem 1.1rem 1.2rem; }
  .fl-product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem; font-weight: 500;
    color: var(--charcoal); margin-bottom: .5rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .fl-product-price {
    font-size: .95rem; font-weight: 600;
    color: var(--maroon); margin-bottom: .75rem;
  }
  .fl-btn-cart {
    width: 100%; padding: .55rem;
    background: var(--maroon); color: #fff;
    border: none; border-radius: 2px;
    font-family: 'Jost', sans-serif;
    font-size: .75rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    cursor: pointer; transition: background .2s;
  }
  .fl-btn-cart:hover { background: var(--maroon-dark); }
  .fl-btn-cart:disabled { opacity: .45; cursor: not-allowed; }

  /* ── Category Cards ── */
  .fl-cat-card {
    position: relative; overflow: hidden;
    border-radius: 3px; min-height: 200px; cursor: pointer;
  }
  .fl-cat-card img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .65s ease;
  }
  .fl-cat-card:hover img { transform: scale(1.08); }
  .fl-cat-card::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(42,26,31,.72) 0%, transparent 55%);
  }
  .fl-cat-info {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.5rem 1.3rem; z-index: 2; color: #fff;
  }
  .fl-cat-info h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; margin-bottom: .15rem;
  }
  .fl-cat-info p { font-size: .72rem; opacity: .75; margin: 0; letter-spacing: .06em; }

  /* ── Testimonials ── */
  .fl-testimonial {
    background: #fff; border: 1px solid var(--cream-mid);
    border-radius: 3px; padding: 1.8rem;
  }
  .fl-testimonial.fl-t-featured { background: var(--maroon); }

  /* ── Newsletter ── */
  .fl-newsletter {
    background: var(--maroon-dark);
    color: #fff; position: relative; overflow: hidden;
    padding: 5rem 0;
  }
  .fl-newsletter::before {
    content: ''; position: absolute;
    top: -80px; right: -80px;
    width: 360px; height: 360px; border-radius: 50%;
    background: rgba(184,150,90,.07);
  }
  .fl-nl-input {
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.2);
    color: #fff; border-radius: 2px 0 0 2px;
    padding: .82rem 1.1rem; font-size: .88rem;
    font-family: 'Jost', sans-serif;
  }
  .fl-nl-input::placeholder { color: rgba(255,255,255,.5); }
  .fl-nl-input:focus {
    outline: none; background: rgba(255,255,255,.15);
    border-color: var(--gold-light); box-shadow: none; color: #fff;
  }
  .fl-btn-gold {
    background: var(--gold); color: #fff;
    border: none; border-radius: 0 2px 2px 0;
    font-family: 'Jost', sans-serif;
    font-size: .75rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    padding: .82rem 1.4rem; white-space: nowrap; cursor: pointer;
    transition: background .2s;
  }
  .fl-btn-gold:hover { background: var(--gold-light); }

  /* ── Stats row ── */
  .fl-stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; color: var(--maroon); line-height: 1;
  }
  .fl-stat-lbl {
    font-size: .68rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--text-muted-c);
  }
  .fl-stat-divider { width: 1px; background: var(--cream-mid); }
</style>

