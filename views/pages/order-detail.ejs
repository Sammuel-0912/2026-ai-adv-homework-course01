<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>" class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <h1 class="mb-4" style="font-size:clamp(1.8rem,3.5vw,2.4rem);font-weight:500;">
        <i class="bi bi-receipt me-2" style="color:var(--maroon);"></i>訂單詳情
      </h1>

      <div v-if="loading" class="d-flex justify-content-center py-5">
        <div class="fl-spinner"></div>
      </div>

      <template v-else-if="order">

        <!-- Payment Result Alert -->
        <div
          v-if="paymentResult && paymentMessages[paymentResult]"
          class="rounded-2 p-3 mb-4 d-flex align-items-center gap-2"
          :style="paymentMessages[paymentResult].style"
          style="font-size:.88rem;"
        >
          <i class="bi"
            :class="paymentResult === 'success' ? 'bi-check-circle-fill' : (paymentResult === 'failed' ? 'bi-x-circle-fill' : 'bi-info-circle-fill')"
          ></i>
          {{ paymentMessages[paymentResult].text }}
        </div>

        <!-- Order Info -->
        <div class="fl-card p-4 mb-4">
          <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
            <div>
              <div style="font-size:.82rem;color:var(--text-muted-c);">訂單編號：{{ order.order_no }}</div>
              <div style="font-size:.75rem;color:var(--text-muted-c);margin-top:.3rem;">
                建立日期：{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}
              </div>
            </div>
            <span
              style="font-size:.72rem;padding:.3rem .8rem;border-radius:2px;font-weight:600;letter-spacing:.04em;"
              :style="statusMap[order.status]?.style || 'background:#f3f4f6;color:#6b7280;'"
            >
              {{ statusMap[order.status]?.label || order.status }}
            </span>
          </div>
        </div>

        <!-- Recipient Info -->
        <div class="fl-card p-4 mb-4">
          <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;margin-bottom:1rem;">收件資訊</h5>
          <div style="font-size:.88rem;color:var(--text-muted-c);line-height:2;">
            <div><span style="color:var(--charcoal);font-weight:500;">收件人：</span>{{ order.recipient_name }}</div>
            <div><span style="color:var(--charcoal);font-weight:500;">Email：</span>{{ order.recipient_email }}</div>
            <div><span style="color:var(--charcoal);font-weight:500;">地址：</span>{{ order.recipient_address }}</div>
          </div>
        </div>

        <!-- Order Items -->
        <div class="fl-card p-4 mb-4">
          <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;margin-bottom:1rem;">商品明細</h5>
          <table class="w-100" style="font-size:.88rem;">
            <thead>
              <tr style="border-bottom:1px solid var(--cream-mid);">
                <th class="text-start py-2 fw-normal" style="color:var(--text-muted-c);">商品名稱</th>
                <th class="text-end py-2 fw-normal" style="color:var(--text-muted-c);">單價</th>
                <th class="text-end py-2 fw-normal" style="color:var(--text-muted-c);">數量</th>
                <th class="text-end py-2 fw-normal" style="color:var(--text-muted-c);">小計</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="item in order.items" :key="item.id" style="border-bottom:1px solid var(--cream-mid);">
                <td class="py-3" style="color:var(--charcoal);">{{ item.product_name }}</td>
                <td class="py-3 text-end" style="color:var(--text-muted-c);">NT$ {{ item.product_price.toLocaleString() }}</td>
                <td class="py-3 text-end" style="color:var(--text-muted-c);">{{ item.quantity }}</td>
                <td class="py-3 text-end" style="color:var(--charcoal);font-weight:600;">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3" class="pt-3 text-end fw-bold" style="color:var(--charcoal);">總計</td>
                <td class="pt-3 text-end" style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:500;color:var(--maroon);">
                  NT$ {{ order.total_amount.toLocaleString() }}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Payment Buttons -->
        <div v-if="order.status === 'pending'" class="d-flex flex-wrap gap-3">
          <button
            @click="goToECPay"
            :disabled="paying"
            class="btn-maroon"
            style="padding:.75rem 2rem;font-size:.82rem;"
          >
            <i class="bi bi-credit-card me-1"></i>
            {{ paying ? '跳轉中...' : '前往綠界付款' }}
          </button>
          <button
            @click="queryPaymentStatus"
            :disabled="querying"
            class="btn-outline-maroon"
            style="padding:.75rem 2rem;font-size:.82rem;"
          >
            <i class="bi bi-arrow-clockwise me-1"></i>
            {{ querying ? '查詢中...' : '查詢付款狀態' }}
          </button>
        </div>
        <div v-else-if="order.status !== 'pending'" class="d-flex gap-3">
          <button
            @click="queryPaymentStatus"
            :disabled="querying"
            class="btn-outline-maroon"
            style="padding:.75rem 2rem;font-size:.82rem;"
          >
            <i class="bi bi-arrow-clockwise me-1"></i>
            {{ querying ? '查詢中...' : '再次確認付款狀態' }}
          </button>
        </div>

        <div class="mt-4">
          <a href="/orders" style="font-size:.78rem;color:var(--text-muted-c);text-decoration:none;">
            ← 返回訂單列表
          </a>
        </div>

      </template>

    </div>
  </div>
</div>
